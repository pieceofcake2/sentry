{
    "name": "pieceofcake2/sentry",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": "*",
        "pieceofcake2/cakephp": "^2.10",
        "sentry/sentry": "^4.11"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "installer-name": "Sentry"
    },
    "require-dev": {
        "pieceofcake2/app": "^2.1"
    }
}
